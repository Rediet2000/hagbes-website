# =====================================================================
# Environment configuration for the GWM / HAGBES site
# ---------------------------------------------------------------------
# Copy this file to .env and adjust the values:
#     cp .env.example .env
# Docker Compose reads .env automatically. The deploy/install.sh script
# also sources it. .env is git-ignored; .env.example is committed.
#
# NOTE: database passwords are written into the MySQL data volume on the
# FIRST run only. Changing them here later does not re-key an existing
# database — set them before the first `docker compose up`.
# =====================================================================

# ---- Site -----------------------------------------------------------
# Public URL. Local dev: http://localhost:8080
# Production: your real domain, e.g. https://gwm.hagbes.com
SITE_URL=http://localhost:8080

# ---- Host ports -----------------------------------------------------
WORDPRESS_PORT=8080
PHPMYADMIN_PORT=8180

# ---- Data location (production bind mounts; ignored locally) --------
# compose.override.yml points the webroot at ./html for local dev, so
# this only matters on the server.
APP_DIR=/opt/website

# ---- Database -------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=change-this-db-password
WORDPRESS_TABLE_PREFIX=wp_

# ---- WordPress admin (used by install.sh to create the admin if missing)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-this-admin-password
WP_ADMIN_EMAIL=admin@example.com
# Set to 1 to RESET the admin password to WP_ADMIN_PASSWORD on install
# (otherwise an existing admin is left untouched).
WP_ADMIN_RESET=0

# ---- PHP tuning -----------------------------------------------------
PHP_MEMORY_LIMIT=1024M
PHP_UPLOAD_MAX_FILESIZE=128M
PHP_POST_MAX_SIZE=128M
WORDPRESS_MEM_LIMIT=2g

# ---- Docker ---------------------------------------------------------
DOCKER_NETWORK=wordpress_network
